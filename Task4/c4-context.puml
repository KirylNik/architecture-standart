@startuml
!include <C4/C4_Context>

title Ставки для кол-центров: диаграмма контекста

Person(client, "Клиент", "Звонит, чтобы узнать условия по депозитам")
Person(back, "Сотрудники бэк-офиса", "Ведут ставки в модуле ставок АБС")
Person(cc_op, "Оператор кол-центра банка", "Консультирует клиентов по ставкам")
Person_Ext(pcc_op, "Оператор партнёрского кол-центра", "Берёт часть звонков при перегрузке")

System(abs, "АБС", "Модуль ставок, сервис интеграции публикует ставки в Kafka")
System(cc, "Система кол-центра", "Новый сервис ставок: копия ставок для операторов и выгрузка файла для партнёра")
System(sftp, "SFTP-сервер для партнёров", "Новый, в DMZ банка. Папка на каждого партнёра")
System_Ext(pcc, "Система партнёрского кол-центра", "Внешняя система, принимает ставки только файлами")

Rel(back, abs, "Меняют ставки")
Rel(abs, cc, "Передаёт публичные ставки", "Kafka")
Rel(client, cc_op, "Звонит")
Rel(client, pcc_op, "Звонит")
Rel(cc_op, cc, "Смотрит актуальные ставки")
Rel(cc, sftp, "Кладёт файл со ставками", "SFTP, CSV")
Rel(pcc, sftp, "Забирает файл по расписанию", "SFTP")
Rel(pcc_op, pcc, "Смотрит ставки из файла")

SHOW_LEGEND()
@enduml
