@startuml
!include <C4/C4_Context>

title Открытие депозитов онлайн (MVP): диаграмма контекста

Person(client, "Клиент", "Смотрит депозиты и ставки, подаёт заявку на сайте или в интернет-банке")
Person(cc_manager, "Менеджер кол-центра", "Разбирает заявки с сайта и звонит клиентам")
Person(front, "Сотрудник отделения", "Идентифицирует нового клиента и открывает ему депозит")
Person(deposit_back, "Менеджер бэк-офиса депозитов", "Согласует ставку и условия по заявке")
Person(credit_back, "Сотрудник бэк-офиса кредитов", "Ведёт базовые ставки и данные по кредитному риску")

System(site, "Сайт", "Показывает депозиты и ставки, принимает заявки от новых клиентов")
System(ib, "Интернет-банк", "Вместе с новым сервисом депозитов: ставки, заявки, СМС-коды и уведомления")
System(cc, "Система кол-центра", "Принимает заявки с сайта, менеджеры работают с ними")
System(abs, "АБС", "Учёт счетов и депозитов, модуль ставок, согласование заявок")

System_Ext(sms, "СМС-шлюз телеком-оператора", "Отправляет СМС через оператора, не меняется")
System_Ext(telecom, "Телеком-оператор", "Внешний оператор, доставляет СМС")

Rel(client, site, "Смотрит ставки, оставляет заявку", "HTTPS")
Rel(client, ib, "Смотрит ставки, подаёт заявку, вводит СМС-код", "HTTPS")
Rel(site, ib, "Берёт депозиты и ставки", "JSON/HTTPS")
Rel(site, cc, "Передаёт заявку", "JSON/HTTPS")
Rel(cc_manager, cc, "Разбирает заявки")
Rel(ib, abs, "Отправляет заявки, получает ставки и статусы", "Kafka")
Rel(deposit_back, abs, "Согласует заявки, смотрит ставки")
Rel(credit_back, abs, "Ведёт ставки и данные по риску")
Rel(front, abs, "Открывает депозит после идентификации")
Rel(ib, sms, "Отправляет СМС-коды и уведомления")
Rel(sms, telecom, "Передаёт СМС")
Rel(telecom, client, "Доставляет СМС")

SHOW_LEGEND()
@enduml
