mxGeometry x="260" y="972" width="210" height="130" as="geometry"/></mxCell><mxCell id="cell_6_A" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="470" y="972" width="210" height="130" as="geometry"/></mxCell><mxCell id="cell_6_C" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="680" y="972" width="210" height="130" as="geometry"/></mxCell><mxCell id="cell_6_F" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="890" y="972" width="210" height="130" as="geometry"/></mxCell><mxCell id="cell_6_D" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="1100" y="972" width="210" height="130" as="geometry"/></mxCell><mxCell id="cell_6_E" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="1310" y="972" width="210" height="130" as="geometry"/></mxCell><mxCell id="sys_0_0_0" value="Интернет-банк&lt;sup&gt;1&lt;/sup&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#DAE3F7;strokeColor=none;fontColor=#1A1A1A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="692" y="724" width="396" height="36" as="geometry"/></mxCell><mxCell id="sys_1_0_0" value="АБС&lt;sup&gt;2&lt;/sup&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#DAE3F7;strokeColor=none;fontColor=#1A1A1A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="482" y="204" width="1026" height="366" as="geometry"/></mxCell><mxCell id="sys_2_0_0" value="Система кол-центра" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#DAE3F7;strokeColor=none;fontColor=#1A1A1A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="272" y="594" width="186" height="106" as="geometry"/></mxCell><mxCell id="sys_3_0_0" value="Система&lt;br&gt;партнёрского кол-центра&lt;br&gt;&lt;i&gt;(внешняя)&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontColor=#1A1A1A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="272" y="984" width="186" height="106" as="geometry"/></mxCell><mxCell id="sys_4_0_0" value="СМС-шлюз телеком-оператора&lt;sup&gt;1&lt;/sup&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#DAE3F7;strokeColor=none;fontColor=#1A1A1A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="692" y="768" width="186" height="52" as="geometry"/></mxCell><mxCell id="sys_5_0_0" value="Сайт&lt;sup&gt;1&lt;/sup&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#DAE3F7;strokeColor=none;fontColor=#1A1A1A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="272" y="724" width="396" height="36" as="geometry"/></mxCell><mxCell id="note_0" value="1. Сайтом, интернет-банком и СМС-шлюзом пользуются клиенты, а не сотрудники, поэтому они стоят в строке IT: отдел их сопровождает и дорабатывает. Сайт пока только показывает информацию о продуктах." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="1118" width="1520" height="24" as="geometry"/></mxCell><mxCell id="note_1" value="2. Операторы кол-центра в АБС не работают: обращения попадают туда из системы кол-центра." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="1142" width="1520" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
